# Backend (Java) taban adresi. Docker'da servis adı: http://backend:8080
BACKEND_URL=http://127.0.0.1:8080

# Backend ile paylaşılan sır; backend'deki BOT_TOKEN ile AYNI olmalı (en az 32 karakter)
# Üretmek için: openssl rand -hex 24
BOT_TOKEN=

# Eşleştirme (QR) sayfasının portu
PAIR_PORT=3000

# Telefon numarasıyla eşleştirme (opsiyonel): ülke kodu dahil, + olmadan
# Örnek: 905321234567
PAIR_PHONE=

# Log seviyesi: trace | debug | info | warn | error
LOG_LEVEL=warn
