# Backend ortam değişkenleri (sır içermez; gerçek değerler .env dosyasında)
DB_HOST=127.0.0.1
DB_PORT=5437
DB_NAME=mini_dealership

# Bot rolüyle bağlanan login kullanıcısı (NOLOGIN grup rolüne üyedir)
BOT_DB_USER=bot_app
BOT_DB_PASS=

# Köprü ile paylaşılan sır (kopru/.env içindeki BOT_TOKEN ile AYNI, ≥32 karakter)
BOT_TOKEN=

BIND_ADRESI=127.0.0.1
HTTP_PORT=8080

# LLM sağlayıcısı: gemini | mistral  (anahtar yoksa yalnız /bot/mesaj 503 döner)
LLM_SAGLAYICI=mistral

# Mistral platformu (OpenAI uyumlu). Demo modeli DeepSeek V4.1 Flash.
MISTRAL_API_KEY=
MISTRAL_MODEL=deepseek-v4-1-flash-1017
# MISTRAL_URL=https://api.mistral.ai/v1
# MISTRAL_EFOR=          # reasoning_effort: low|high|max (model desteklemiyorsa boş bırak)

# Gemini (yedek sağlayıcı)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
